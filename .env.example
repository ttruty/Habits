# Copy to .env.live.local (gitignored) and run `npm run dev:live`.
# `npm run dev` ignores these and uses demo data.
#
# Hosted project: Supabase dashboard → Project Settings → API.
# Local stack (`npx supabase start`): http://127.0.0.1:54321 and the anon key it prints.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable or anon key>
